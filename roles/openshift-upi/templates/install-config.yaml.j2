apiVersion: v1
baseDomain: "{{ DOMAIN_NAME }}"
metadata:
  name: "{{ CLUSTER_NAME }}"
compute:
- name: worker
  replicas: {{ WORKER_NODE_COUNT | int }}
controlPlane:
  name: master
  replicas: {{ MASTER_NODE_COUNT | int }}
platform:
  none: {}
networking:
  clusterNetwork:
  - cidr: "{{ CLUSTER_NETWORK }}"
    hostPrefix: {{ HOST_PREFIX | int }}
  serviceNetwork:
  - "{{ SERVICE_NETWORK }}"
  machineNetwork:
  - cidr: "{{ MACHINE_NETWORK }}"
  networkType: "{{ CNI }}"
fips: false
pullSecret: '{{ PULL_SECRET | to_json }}'
sshKey: "{{ SSH_KEY }}"
